{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed Evidence Bundle v1 — I issues, B consumes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "course_id",
    "binding_version",
    "issuer",
    "audience",
    "kid",
    "jti",
    "issued_at",
    "expires_at",
    "allowed_purpose",
    "authorization_version",
    "sources",
    "signature"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_version": {
      "type": "integer",
      "minimum": 1
    },
    "issuer": {
      "const": "sunrise-integration"
    },
    "audience": {
      "const": "sunrise-operations"
    },
    "kid": {
      "type": "string",
      "minLength": 1
    },
    "jti": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_purpose": {
      "enum": [
        "paper_draft",
        "lesson_draft"
      ]
    },
    "authorization_version": {
      "type": "integer",
      "minimum": 1
    },
    "signature": {
      "type": "string",
      "minLength": 16
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_version_id",
          "content_sha256",
          "locator",
          "excerpt",
          "retrieved_at",
          "publish_state",
          "usage_policy_ref"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_version_id": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "publish_state": {
            "const": "PUBLISHED"
          },
          "usage_policy_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
