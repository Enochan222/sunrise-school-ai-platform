{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed v0.7 Manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "stage",
    "owner_track",
    "components",
    "compatibility",
    "evidence",
    "owner_signoff"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^R(0[1-9]|1[0-9]|2[0-8])$"
    },
    "stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28
    },
    "owner_track": {
      "enum": [
        "A",
        "B",
        "I",
        "U"
      ]
    },
    "components": {
      "type": "object",
      "required": [
        "A",
        "B",
        "I",
        "U"
      ],
      "properties": {
        "A": {
          "type": [
            "object",
            "null"
          ]
        },
        "B": {
          "type": [
            "object",
            "null"
          ]
        },
        "I": {
          "type": [
            "object",
            "null"
          ]
        },
        "U": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "contract_versions": {
      "type": "object"
    },
    "feature_flags": {
      "type": "object"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "migration_strategy",
        "rollback_safe",
        "forward_fix_plan"
      ],
      "properties": {
        "minimum_api_versions": {
          "type": "object"
        },
        "migration_strategy": {
          "enum": [
            "additive",
            "expand",
            "migrate",
            "contract",
            "none"
          ]
        },
        "rollback_safe": {
          "type": "boolean"
        },
        "forward_fix_plan": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "acceptance_urls",
        "restore_evidence",
        "owner_runtime_diff"
      ],
      "properties": {
        "acceptance_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restore_evidence": {
          "type": "string"
        },
        "owner_runtime_diff": {
          "type": "string"
        },
        "security_negative_tests": {
          "type": "string"
        }
      }
    },
    "owner_signoff": {
      "type": "string"
    }
  }
}
